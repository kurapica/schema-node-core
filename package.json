{
  "name": "schema-node-core",
  "version": "1.0.0",
  "description": "TypeScript schema execution framework — mirrors C# SchemaNode.Core. Language-agnostic core for declarative schema definition via @Meta decorators, property composition, and extensible schema families.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "schema",
    "metadata",
    "property",
    "relation",
    "function",
    "declarative",
    "typescript",
    "property-composition"
  ],
  "files": [
    "dist"
  ],
  "author": "kurapica125@outlook.com",
  "license": "Apache License 2.0",
  "dependencies": {
    "bignumber.js": "^9.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kurapica/schema-node-core.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
